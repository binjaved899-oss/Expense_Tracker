{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first full-stack personal and household Expense Tracker with multi-account ledger, split transactions, rollover budgets, recurring bills, itemized receipts, and SVG cashflow analytics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node -e \"const fs=require('fs'),cp=require('child_process'); if(fs.existsSync('tests/e2e') && fs.readdirSync('tests/e2e').some(f=>f.endsWith('.spec.ts'))){ cp.execSync('npx playwright test',{stdio:'inherit'}); } else { console.log('[e2e] Deferred until M12 E2E suite is mounted.'); }\""
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/swagger": "8.15.0",
    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.36.4",
    "fastify": "4.28.1",
    "lucide-react": "0.468.0",
    "pino": "9.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@playwright/test": "1.45.3",
    "@testing-library/react": "16.1.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.28.1",
    "eslint": "9.16.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "tailwindcss": "3.4.16",
    "tsx": "4.19.2",
    "typescript": "5.5.4",
    "typescript-eslint": "8.17.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
